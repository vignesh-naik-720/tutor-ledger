# ==============================================================================
# Tutor Ledger — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) to customize your environment.
# Pre-filled 64-hex development keys are provided below for immediate local testing.

# 1. TL_SESSION_PEPPER (Required - 64 hex characters)
# Server-side HMAC secret applied to session tokens before hashing.
# Prevents forged sessions even if the database is compromised.
TL_SESSION_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. TL_AUDIT_HMAC_KEY (Required - 64 hex characters)
# Cryptographic key used to create tamper-evident SHA-256 hash chains across audit log events.
# Ensures audit history is immutable and append-only.
TL_AUDIT_HMAC_KEY=123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0

# 3. TL_FIELD_ENCRYPTION_KEK (Required - 64 hex characters)
# Key Encryption Key (AES-256-GCM) used to encrypt sensitive student family names
# and parent phone numbers at rest in the database.
TL_FIELD_ENCRYPTION_KEK=23456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef01

# 4. TL_PHONE_HMAC_KEY (Required - 64 hex characters)
# Blind index key used to compute deterministic hashes of normalized phone numbers.
# Allows duplicate family detection without decrypting all database records.
TL_PHONE_HMAC_KEY=3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012

# 5. TL_SETUP_SECRET (Required string)
# Administrative secret required to create the first owner account during setup.
# Setup locks down permanently once the first owner account is registered.
TL_SETUP_SECRET=TUTOR_LEDGER_DEV_SECRET_2026

# 6. TL_DATABASE_URL (Optional)
# PostgreSQL connection string:
# - For Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/tutor_ledger
# - For Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/tutor_ledger
# - For Zero-Setup Local Execution: Leave blank or set to 'embedded' to use the local
#   JSON persistence store (backend/data/tutor_ledger_store.json) without running Postgres.
TL_DATABASE_URL=
TL_MIGRATION_DATABASE_URL=

# 7. GEMINI_API_KEY (Optional)
# Google Gemini 1.5 Flash API Key for online AI Copilot and natural language message parsing.
# If omitted or blank, the app seamlessly uses its built-in offline NLP engine with zero errors.
GEMINI_API_KEY=

# 8. Server & Host Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
